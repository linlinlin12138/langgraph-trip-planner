# Copy to .env and edit. Never commit .env.

# ---- model layer: mock | openai | anthropic | gemini -------------------------
LLM_PROVIDER=mock
# Leave empty for the provider's default small model (see src/trip_agents/llm/factory.py)
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Provider keys (only the one you use is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=          # or GEMINI_API_KEY

# ---- tools: mock (offline fixed data) | real (Open-Meteo weather + OSRM routes; other tools use mock data)
TOOL_BACKEND=mock

# ---- agent behaviour ---------------------------------------------------------
MAX_REVISIONS=2
STRUCTURED_MAX_RETRIES=3
RESEARCH_MAX_STEPS=8
RESEARCH_MAX_ROUNDS_PER_TOOL=3

# ---- tool transport: mcp (Research talks to an MCP stdio server) | local (in-process) ----
TOOL_TRANSPORT=mcp

# ---- Gemini -------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_MODEL=           # empty = gemini-3.8-flash; `make check-provider ARGS="--provider gemini --list-models"` lists what your key can use
#                      # (gemini-2.5-flash returns 404 "no longer available to new users" for keys created since late 2026)
# LLM_THINKING_LEVEL=low  # Gemini 3+: minimal | low (default) | medium | high | default (= model decides)
# LLM_THINKING_BUDGET= # Gemini 2.5 only: token budget; 0 disables thinking
# LLM_MAX_RETRIES=6    # SDK backoff on 429/5xx
# Prices are NOT built in. After checking the official pricing page, set USD per 1M tokens (input, output):
# PRICING_OVERRIDES={"<model>": [<input>, <output>]}

# ---- semantic cache (optional) --------------------------------------------------
SEMANTIC_CACHE=false
CACHE_THRESHOLD=0.85
CACHE_TTL_DAYS=7
